{
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".react-router/types/**/*",
		"app/components/assets/geoPlaces.js",
		"app/components/geo-search.client.tsx",
		"#app/components/puzzle.client.js"
	],
	"extends": ["@epic-web/config/typescript"],
	"compilerOptions": {
		// TODO: Probably should move this into epic-web/config
		"types": ["@react-router/node", "vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"#app/*": ["./app/*"],
			"#tests/*": ["./tests/*"],
			"@/icon-name": [
				"./app/components/ui/icons/name.d.ts",
				"./types/icon-name.d.ts"
			]
		}
	}
}
